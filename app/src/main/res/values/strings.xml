    <!-- Tutorial -->
    <string name="tut_title">How to Play</string>
    <string name="tut_1_title">Roll a six</string>
    <string name="tut_1_body">Only a six brings a token out of the yard onto your coloured start square.</string>
    <string name="tut_2_title">Move and capture</string>
    <string name="tut_2_body">Tap a glowing token to move it. Landing on an opponent dissolves their token into powder and reforms it back in the yard.</string>
    <string name="tut_3_title">Stay safe</string>
    <string name="tut_3_body">Star cells and coloured start cells can never be captured. Two of your tokens on one cell form a blockade.</string>
    <string name="tut_4_title">Bring all four home</string>
    <string name="tut_4_body">The exact number is needed to enter home. The first player to bring all four tokens home wins.</string>

    <!-- About -->
    <string name="about_title">About Apex Ludo</string>
    <string name="about_body">Apex Ludo v1.1 (beta) — a clean-room, offline, ad-free Ludo built from scratch.\n\n• No ads, no trackers, no network permission\n• Six on-device bot personalities\n• Fully configurable rules\n• Custom 60 fps canvas renderer with battery saver\n\nThis is a beta build. If anything glitches, the app saves a log you can share.</string>
    <string name="about_credits">Engine, art and AI built in-house. No third-party assets.</string>

